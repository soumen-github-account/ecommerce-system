<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ===================================================== -->
    <!-- MATERIAL CARD -->
    <!-- ===================================================== -->

    <style name="App.Card" parent="Widget.Material3.CardView.Elevated">

        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="strokeWidth">@dimen/card_stroke</item>
        <item name="strokeColor">@color/card_border</item>
        <item name="cardBackgroundColor">@color/card_bg</item>

    </style>


    <!-- ===================================================== -->
    <!-- PRIMARY BUTTON -->
    <!-- ===================================================== -->

    <style name="App.Button.Primary"
        parent="Widget.Material3.Button">

        <item name="backgroundTint">@color/button_primary</item>

        <item name="cornerRadius">@dimen/button_radius</item>

        <item name="android:textColor">@color/button_primary_text</item>

        <item name="android:textStyle">bold</item>

        <item name="android:textAllCaps">false</item>

    </style>


    <!-- ===================================================== -->
    <!-- OUTLINE BUTTON -->
    <!-- ===================================================== -->

    <style name="App.Button.Outline"
        parent="Widget.Material3.Button.OutlinedButton">

        <item name="strokeColor">@color/button_primary</item>

        <item name="strokeWidth">1dp</item>

        <item name="cornerRadius">@dimen/button_radius</item>

        <item name="android:textColor">@color/button_primary</item>

        <item name="android:textAllCaps">false</item>

        <item name="android:textStyle">bold</item>

    </style>


    <!-- ===================================================== -->
    <!-- TEXT INPUT -->
    <!-- ===================================================== -->

    <style name="App.TextInput"
        parent="Widget.Material3.TextInputLayout.OutlinedBox">

        <item name="boxCornerRadiusTopStart">@dimen/textfield_radius</item>

        <item name="boxCornerRadiusTopEnd">@dimen/textfield_radius</item>

        <item name="boxCornerRadiusBottomStart">@dimen/textfield_radius</item>

        <item name="boxCornerRadiusBottomEnd">@dimen/textfield_radius</item>

        <item name="boxStrokeColor">@color/primary</item>

        <item name="hintTextColor">@color/text_hint</item>

    </style>


    <!-- ===================================================== -->
    <!-- HEADING -->
    <!-- ===================================================== -->

    <style name="App.Text.Heading">

        <item name="android:textSize">@dimen/text_h1</item>

        <item name="android:textStyle">bold</item>

        <item name="android:textColor">@color/text_primary</item>

    </style>


    <!-- ===================================================== -->
    <!-- TITLE -->
    <!-- ===================================================== -->

    <style name="App.Text.Title">

        <item name="android:textSize">@dimen/text_title</item>

        <item name="android:textStyle">bold</item>

        <item name="android:textColor">@color/text_primary</item>

    </style>


    <!-- ===================================================== -->
    <!-- BODY -->
    <!-- ===================================================== -->

    <style name="App.Text.Body">

        <item name="android:textSize">@dimen/text_body</item>

        <item name="android:textColor">@color/text_secondary</item>

    </style>
    <style name="App.Text">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="App">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>


</resources>