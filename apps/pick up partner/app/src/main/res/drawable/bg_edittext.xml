<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Focused -->

    <item android:state_focused="true">

        <shape>

            <solid android:color="@color/surface"/>

            <stroke
                android:width="2dp"
                android:color="@color/primary"/>

            <corners android:radius="14dp"/>

            <padding
                android:left="16dp"
                android:top="14dp"
                android:right="16dp"
                android:bottom="14dp"/>

        </shape>

    </item>

    <!-- Disabled -->

    <item android:state_enabled="false">

        <shape>

            <solid android:color="#F3F4F6"/>

            <stroke
                android:width="1dp"
                android:color="@color/card_border"/>

            <corners android:radius="14dp"/>

        </shape>

    </item>

    <!-- Default -->

    <item>

        <shape>

            <solid android:color="@color/surface"/>

            <stroke
                android:width="1dp"
                android:color="@color/card_border"/>

            <corners android:radius="14dp"/>

            <padding
                android:left="16dp"
                android:top="14dp"
                android:right="16dp"
                android:bottom="14dp"/>

        </shape>

    </item>

</selector>