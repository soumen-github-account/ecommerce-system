<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="18dp"
    app:cardElevation="3dp"
    app:strokeColor="@color/card_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Row -->

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/txtPickupId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PK1023"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/text_primary"/>

            <TextView
                android:id="@+id/txtStatus"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_alignParentEnd="true"
                android:gravity="center"
                android:minWidth="70dp"
                android:text="Pending"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#F97316"
                android:background="@drawable/bg_chip_pending"/>

        </RelativeLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="10dp"/>

        <!-- Seller -->

        <TextView
            android:id="@+id/txtSellerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ABC Electronics"
            android:textStyle="bold"
            android:textSize="19sp"
            android:textColor="@color/text_primary"/>

        <Space
            android:layout_width="match_parent"
            android:layout_height="6dp"/>

        <!-- Address -->

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/ic_location"/>

            <Space
                android:layout_width="6dp"
                android:layout_height="1dp"/>

            <TextView
                android:id="@+id/txtAddress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Salt Lake, Kolkata"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"/>

        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="6dp"/>

        <!-- Distance -->

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/ic_distance"/>

            <Space
                android:layout_width="6dp"
                android:layout_height="1dp"/>

            <TextView
                android:id="@+id/txtDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3.2 KM"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"/>

        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="6dp"/>

        <!-- Time -->

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/ic_time"/>

            <Space
                android:layout_width="6dp"
                android:layout_height="1dp"/>

            <TextView
                android:id="@+id/txtTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10:30 AM - 12:00 PM"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"/>

        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="18dp"/>

        <!-- Bottom Buttons -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewDetails"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="View Details"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                app:backgroundTint="@color/primary"
                app:cornerRadius="12dp"/>

            <Space
                android:layout_width="12dp"
                android:layout_height="1dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="50dp"
                android:layout_height="50dp"
                app:cardCornerRadius="25dp"
                app:cardElevation="0dp"
                android:background="@color/white"
                app:strokeColor="@color/primary"
                app:strokeWidth="1.5dp">

                <ImageView
                    android:id="@+id/btnCall"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_phone"
                    android:tint="@color/primary"/>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>