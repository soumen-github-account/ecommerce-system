<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="310dp"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#211C63"
    android:paddingTop="48dp">

    <!-- ========================= -->
    <!-- Profile -->
    <!-- ========================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <ImageView
            android:id="@+id/imgDrawerProfile"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_circle"
            android:padding="2dp"
            android:scaleType="centerCrop"
            android:src="@drawable/demo_profile"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtDrawerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rakesh Kumar"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:textSize="18sp"/>

            <TextView
                android:id="@+id/txtDrawerRole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pickup Partner"
                android:textColor="#D7D7D7"
                android:textSize="14sp"/>

        </LinearLayout>

    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="30dp"/>
    <LinearLayout
        android:id="@+id/menuDashboard"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_drawer_selected"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_home_fill"
            app:tint="@android:color/white"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Dashboard"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="16sp"/>

    </LinearLayout>
    <!-- ========================= -->
    <!-- Assigned Pickups -->
    <!-- ========================= -->

    <LinearLayout
        android:id="@+id/menuPickups"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_pickup"
            app:tint="@android:color/white"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Assigned Pickups"
            android:textColor="@android:color/white"
            android:textSize="16sp"/>

    </LinearLayout>

    <!-- ========================= -->
    <!-- History -->
    <!-- ========================= -->

    <LinearLayout
        android:id="@+id/menuHistory"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_time"
            app:tint="@android:color/white"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="History"
            android:textColor="@android:color/white"
            android:textSize="16sp"/>

    </LinearLayout>

    <!-- ========================= -->
    <!-- Earnings -->
    <!-- ========================= -->

    <LinearLayout
        android:id="@+id/menuEarnings"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_earning"
            app:tint="@android:color/white"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Earnings"
            android:textColor="@android:color/white"
            android:textSize="16sp"/>

    </LinearLayout>

    <!-- ========================= -->
    <!-- Profile -->
    <!-- ========================= -->

    <LinearLayout
        android:id="@+id/menuProfile"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_profile"
            app:tint="@android:color/white"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Profile"
            android:textColor="@android:color/white"
            android:textSize="16sp"/>

    </LinearLayout>
    <!-- ========================= -->
    <!-- Notifications -->
    <!-- ========================= -->

    <LinearLayout
        android:id="@+id/menuNotification"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_notifications"
            app:tint="@android:color/white"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="Notifications"
            android:textColor="@android:color/white"
            android:textSize="16sp"/>

        <!-- Badge -->

        <TextView
            android:id="@+id/txtNotificationCount"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_notification_badge"
            android:gravity="center"
            android:text="3"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="12sp"/>

    </LinearLayout>

    <!-- ========================= -->
    <!-- Settings -->
    <!-- ========================= -->

    <LinearLayout
        android:id="@+id/menuSettings"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_settings"
            app:tint="@android:color/white"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Settings"
            android:textColor="@android:color/white"
            android:textSize="16sp"/>

    </LinearLayout>

    <!-- ========================= -->
    <!-- Support -->
    <!-- ========================= -->

    <LinearLayout
        android:id="@+id/menuSupport"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_info"
            app:tint="@android:color/white"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Support"
            android:textColor="@android:color/white"
            android:textSize="16sp"/>

    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- ========================= -->
    <!-- Logout -->
    <!-- ========================= -->

    <LinearLayout
        android:id="@+id/menuLogout"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_logout"
            app:tint="#FF5A5F"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Logout"
            android:textColor="#FF5A5F"
            android:textStyle="bold"
            android:textSize="16sp"/>

    </LinearLayout>

</LinearLayout>